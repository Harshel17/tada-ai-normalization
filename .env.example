# Copy to .env for local use. Nothing here is a real secret; change values for anything shared.
POSTGRES_USER=tada
POSTGRES_PASSWORD=tada_dev_password
POSTGRES_DB=tada_normalize
POSTGRES_PORT=54329

# SQLAlchemy URL used by the API, the CLI `ingest` command and Alembic (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://tada:tada_dev_password@localhost:54329/tada_normalize

# Used only by the integration tests (a separate database that is created automatically).
TEST_DATABASE_URL=postgresql+psycopg://tada:tada_dev_password@localhost:54329/tada_normalize_test

# Secret salt for the one-way hash stored instead of bank account numbers.
# REQUIRED (min. 32 characters, random). Do not type one here: run `uv run python scripts/setup_env.py`,
# which generates it into your local, owner-only .env. There is deliberately no default.
ACCOUNT_HASH_SALT=
